# AI Interview Prep Kit - Environment Configuration

# LLM Provider Configuration
# Get a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=trao-interview-prep-jwt-secret-key-2026

# Database Configuration (MongoDB)
# If MongoDB is unavailable or left blank, the server automatically falls back to local file storage
MONGODB_URI=mongodb://localhost:27017/ai-interview-prep

# Crawler & Security Settings
# When true, allows fetching local addresses (e.g. http://localhost:8099/ for batch evaluation)
ALLOW_LOCAL_URLS=true

# Frontend Configuration (Client)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
