{
  "name": "ai-interview-prep-kit",
  "version": "1.0.0",
  "description": "The AI Interview Prep Kit - Full-Stack Application & Evaluation Engine",
  "main": "core/evaluate.ts",
  "scripts": {
    "evaluate": "tsx core/evaluate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm --prefix client run build",
    "start": "npm --prefix client start"
  },
  "keywords": [
    "ai",
    "interview-prep",
    "nextjs",
    "nodejs",
    "express",
    "gemini"
  ],
  "author": "Trao Candidate",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "autoprefixer": "^10.4.20",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "next": "^14.2.23",
    "nodemailer": "^10.0.1",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
